# ============================================================
# PostgreSQL — variables de entorno del backend
# Copia este archivo a .env y rellena los valores.
# En producción (Render/Neon) define ESTAS MISMAS vars en el panel,
# o usa DATABASE_URL directamente.
# ============================================================

# Opción A (recomendada en producción): connection string completa de Neon
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/dbname?sslmode=require

# Opción B: credenciales por separado (desarrollo local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zaculeu_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_SSL=false

# Puerto del servidor Express
PORT=5000

# Orígenes permitidos por CORS (separados por coma). Usa '*' para permitir
# todos, o lista el dominio del frontend desplegado.
CORS_ORIGINS=http://localhost:5173
